# 이 파일의 값은 `.env` 로 복사된다 (scripts/init-env.sh 가 대신 복사하고, 없는 키만 보충한다).
# `.env`는 .gitignore 에 들어 있어 커밋되지 않는다.
# 비밀번호는 .env 에 두지 않는다. scripts/init-env.sh 가 입력받아 DEK 로 암호화해 .secrets.enc 에 보관하고,
# scripts/run-backend.sh 와 docker/manage.sh 가 실행할 때만 풀어서 환경변수로 넘긴다. (MARIADB_ROOT_PASSWORD, MARIADB_PASSWORD, REDIS_PASSWORD)

# ── MariaDB 컨테이너 (docker/manage.sh up mariadb 가 읽는다) ──
MARIADB_PORT=9000
MARIADB_DATABASE=juso
MARIADB_USER=note

# ── Redis 컨테이너 (docker/manage.sh up redis, image-service 가 읽는다) ──
REDIS_PORT=9001

# ── juso-service (scripts/run-backend.sh 가 읽는다) ──
# LOAD DATA INFILE(서버 직접 읽기)에 FILE 권한이 필요해 root 로 접속한다. 비밀번호는 보관한 MARIADB_ROOT_PASSWORD 와 같다.
JUSO_DB_URL=jdbc:mariadb://localhost:9000/juso?allowLocalInfile=true
JUSO_DB_USER=root
# 적재할 원본 파일(절대 경로). 비워 두면 generate-data/result/202610_juso.txt
JUSO_DATA_FILE=

# ── image-service ──
# 생성한 상품 이미지를 두는 폴더(절대 경로). 비워 두면 프로젝트 루트의 image-data/
IMAGE_DIR=
# 샘플 사진 받기 주소({n} 은 상품 번호)와 동시에 받는 개수. 비워 두면 picsum.photos 와 8개
# IMAGE_SAMPLE_URL=https://picsum.photos/seed/{n}/1200/900
# IMAGE_SAMPLE_THREADS=8

# ── rag-service ──
# 검색 대상 문서 폴더(*.md, 절대 경로)와 임베딩 모델을 내려받아 둘 폴더. 비워 두면 docs/ 와 rag-data/model/
RAG_DOCS_DIR=
RAG_MODEL_DIR=
# 검색 대상에서 뺄 파일 이름(쉼표로 구분). 기본은 없음. docs/ 바로 아래 *.md 만 읽고 하위 폴더(docs/ax, docs/db)는 읽지 않는다
# RAG_DOCS_EXCLUDE=

# ── 실행 환경 (선택) ──
# JDK 25 위치. 비워 두면 OS 별로 자동 탐색한다 (macOS: java_home, Linux: ~/.jdks 와 /usr/lib/jvm). 예: $HOME/.jdks/<jdk-25 폴더>
JAVA_HOME=
