# 이 파일을 `.env`로 복사해서 값을 채운다 (scripts/init-env.sh 가 대신 복사해 준다).
# `.env`는 .gitignore 에 들어 있어 커밋되지 않는다. 비밀번호를 이 파일(.example)에 적지 말 것.

# ── MariaDB 컨테이너 (docker/manage.sh up mariadb 가 읽는다) ──
MARIADB_PORT=9000
MARIADB_DATABASE=juso
MARIADB_ROOT_PASSWORD=
MARIADB_USER=note
MARIADB_PASSWORD=

# ── juso-service (scripts/run-backend.sh 가 읽는다) ──
# LOAD DATA INFILE(서버 직접 읽기)에 FILE 권한이 필요해 root 로 접속한다. MARIADB_ROOT_PASSWORD 와 같은 값.
JUSO_DB_URL=jdbc:mariadb://localhost:9000/juso?allowLocalInfile=true
JUSO_DB_USER=root
JUSO_DB_PASSWORD=
# 적재할 원본 파일(절대 경로). 비워 두면 generate-data/result/202610_juso.txt
JUSO_DATA_FILE=

# ── 실행 환경 (선택) ──
# java 가 PATH 에 없으면 JDK 17 위치를 지정한다. 예: /home/me/.jdks/corretto-17.0.12
JAVA_HOME=
